{
  "version": 2,
  "builds": [
    { "src": "js/server.js", "use": "@vercel/node" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "buildCommand": "npm run build", "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "js/server.js" }
  ]
}
